# Copy this file to .env and fill in your keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Fish Audio (https://fish.audio -> API keys)
FISH_API_KEY=
# "s1" is the model that understands (emotion) tags like (curious) (sighing) (break)
FISH_MODEL=s1

# Voice IDs: open any voice on fish.audio, the ID is the last part of its URL.
# Default voice used when a vibe has no specific voice set.
FISH_VOICE_DEFAULT=
# Optional: a different voice per vibe (leave empty to use the default)
FISH_VOICE_FRIENDLY=
FISH_VOICE_PROFESSIONAL=
FISH_VOICE_STRICT=
FISH_VOICE_SKEPTICAL=
FISH_VOICE_UNINTERESTED=
FISH_VOICE_RUSHED=

PORT=3000
